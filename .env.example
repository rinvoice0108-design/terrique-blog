# ──────────────────────────────────────────────
# .env.example — 이 파일을 .env로 복사한 뒤 실제 값으로 채우세요.
#   cp .env.example .env
# .env 파일은 .gitignore에 등록되어 있어 git에 올라가지 않습니다.
# ──────────────────────────────────────────────

# 네이버 개발자센터 (선택 — 없으면 웹 검색으로 대체)
# 발급: https://developers.naver.com → 애플리케이션 등록 → 검색 API
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID_HERE
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET_HERE

# Nano Banana Pro 이미지 생성 (필수)
# 발급: https://aistudio.google.com (무료)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 선택: 이미지 모델 override
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# ──────────────────────────────────────────────
# 브랜드 시스템 (/setup-domain이 자동으로 채움 — 수동 편집도 가능)
# ──────────────────────────────────────────────
BRAND_NAME=YOUR BRAND
BRAND_BG_COLOR=#F7F6F2
BRAND_FG_COLOR=#1A1A1A
BRAND_ACCENT=#D97A3A

# ──────────────────────────────────────────────
# 일일 자동화 (scripts/daily-runner.js)
# ──────────────────────────────────────────────

# Gmail 앱 비밀번호 (16자리, 공백 없이 입력)
# 발급: Google 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호 생성
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE

# Google Sheets ID (시트 URL의 /d/와 /edit 사이 값)
SHEETS_ID=YOUR_GOOGLE_SHEETS_ID_HERE

# 리포트 메일 수신자 (선택 — 없으면 발송 계정 본인에게 발송)
MAIL_TO=YOUR_RECEIVING_EMAIL_HERE
