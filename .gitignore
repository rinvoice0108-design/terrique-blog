# 환경 변수
.env

# Google 인증 (절대 git에 올리지 않음)
service-account.json
*-credentials.json
.env.local
.env.*.local

# 회사 전략·조사 문서 (이 저장소는 공개다 — 기본 차단 후 일반 문서만 화이트리스트)
# 경쟁사 조사, 내부 비용 산정, 사업 전략 문서가 docs/ 에 섞여 들어온다.
docs/*
!docs/build-history.md
!docs/explainer.md
!docs/how-it-works.md
!docs/setup-guide.md
!docs/troubleshooting.md

# 회사 데이터 (Single Source of Truth — 절대 git에 올리지 않음)
knowledge/brand-facts.md
knowledge/conversion-benchmarks.md
knowledge/banned-words.json
knowledge/facts.json
knowledge/topic-fingerprints.json
knowledge/tone-samples/*.txt
knowledge/tone-samples/*.md
!knowledge/tone-samples/README.md
knowledge/patterns/*.txt
knowledge/patterns/*.md
!knowledge/patterns/README.md

# 생성된 결과물
output/
!output/.gitkeep

# Node.js
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# 에디터
.vscode/
.idea/
*.swp

# Claude Code 로컬 권한 설정 (기기별로 다름, 다른 프로젝트 경로가 섞여있을 수 있음)
.claude/settings.local.json

# 자동화
logs/
